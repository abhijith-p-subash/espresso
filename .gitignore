# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
.venv/
ENV/
env/

# Distribution / build output
build/
dist/
*.egg-info/
*.egg
*.whl

# PyInstaller artefacts.
# Espresso.spec is the build recipe and IS tracked — only generated specs and
# the binaries they produce are ignored.
*.exe
*.app/
*.dmg
!Espresso.spec

# Test and lint caches
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
.mypy_cache/

# Local config
.env

# macOS
.DS_Store
.AppleDouble
.LSOverride
__MACOSX/

# Windows
Thumbs.db
desktop.ini

# Linux
*~
*.swp

# Logs
*.log

# Editors — shared VS Code settings are tracked, personal state is not
.idea/
*.sublime-project
*.sublime-workspace
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
